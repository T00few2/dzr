# Optional dedicated token key. If unset, COACH_CONNECT_SECRET is used.
# COACH_TOKEN_KEY=
# Optional dedicated encryption key for coach memory. If unset, COACH_CONNECT_SECRET is used.
# Must be the same on Vercel and Render if you set it.
# COACH_MEMORY_KEY=
# Optional override; defaults to https://www.dzrracingseries.com
# INTERVALS_CONNECT_BASE_URL=https://www.dzrracingseries.com

# Per-athlete daily coaching token ceiling. A safety net against a runaway loop, not rationing.
# Default 300000. Set to 0 to disable the cap entirely.
# COACH_DAILY_TOKEN_BUDGET=300000
