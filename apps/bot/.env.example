DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=1195850595014299669
CONTENT_API_BASE_URL=https://zwiftpower-733125196297.us-central1.run.app
CONTENT_API_KEY=
FIREBASE_PROJECT_ID=dzr-member-site
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OPENAI_API_KEY=
# Club assistant uses the stateless Responses API. Change only this value to roll back models.
CLUB_ASSISTANT_MODEL=gpt-6-luna
CLUB_ASSISTANT_REASONING_EFFORT=low
CLUB_ASSISTANT_MAX_OUTPUT_TOKENS=1200

# DZR Coach uses the stateless Responses API. Change only COACH_MODEL to roll back models.
COACH_MODEL=gpt-6-luna
COACH_REASONING_EFFORT=low
COACH_ANALYSIS_REASONING_EFFORT=medium

# Signs intervals.icu connect links. Same value as the website. The bot does not exchange OAuth tokens.
# If coach memory was encrypted before this change, paste the previous connect-secret value here.
COACH_CONNECT_SECRET=
# Optional dedicated token key. If unset, COACH_CONNECT_SECRET is used.
# COACH_TOKEN_KEY=
# Optional dedicated encryption key for coach memory. If unset, COACH_CONNECT_SECRET is used.
# Must be the same on Vercel and Render if you set it.
# COACH_MEMORY_KEY=
# Optional override; defaults to https://www.dzrracingseries.com
# INTERVALS_CONNECT_BASE_URL=https://www.dzrracingseries.com

# Per-athlete daily coaching token ceiling. A safety net against a runaway loop, not rationing.
# Default 600000. Cached prompt tokens count at 10%. Set to 0 to disable the cap entirely.
# COACH_DAILY_TOKEN_BUDGET=600000
