{
  "root": true,
  "env": { "node": true, "commonjs": true, "es2023": true },
  "parserOptions": { "ecmaVersion": 2023, "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-console": "off"
  }
}
