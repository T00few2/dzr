rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Existing client features — keep production behavior.
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write, create, update, delete: if request.auth.uid == userId;
    }

    match /riders/{riderId} {
      allow read, write: if request.auth != null;
    }

    match /raceSignups/{docId} {
      allow read, write: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Coaching / membership — client SDK must not read these.
    // Admin SDK (Next API + Discord bot) bypasses rules.
    // Unmatched collections are already denied by default; these are explicit.
    match /strava_connections/{id} {
      allow read, write: if false;
    }
    match /coach_profiles/{id} {
      allow read, write: if false;
    }
    match /coach_chat_notes/{id} {
      allow read, write: if false;
      match /notes/{noteId} {
        allow read, write: if false;
      }
    }
    match /coach_usage/{id} {
      allow read, write: if false;
    }
    match /coach_usage_events/{id} {
      allow read, write: if false;
    }
    match /payments/{id} {
      allow read, write: if false;
    }
    match /memberships/{id} {
      allow read, write: if false;
    }
    match /system_settings/{id} {
      allow read, write: if false;
    }
    match /onboarding_sessions/{id} {
      allow read, write: if false;
    }
  }
}
