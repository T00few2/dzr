# Website (Next.js) — copy to .env.local. Do not commit secrets.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=1195850595014299669
DISCORD_REQUIRED_ROLE_ID=1385216556166025347
DISCORD_BOT_TOKEN=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Public Firebase web config (ok in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dzr-member-site
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin. Do not put the private key in NEXT_PUBLIC_*.
# After copying these on Vercel, rotate the service-account key in Google Cloud.
FIREBASE_PROJECT_ID=dzr-member-site
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Next can trigger Flask roster refresh
CONTENT_API_BASE_URL=https://zwiftpower-733125196297.us-central1.run.app
CONTENT_API_KEY=

# intervals.icu coaching. Register the OAuth app on intervals.icu (Settings → the app's Manage page).
# Redirect URI must be https://www.dzrracingseries.com/api/intervals/callback
# Scopes requested by the site: ACTIVITY:READ,WELLNESS:READ,SETTINGS:READ,CALENDAR:WRITE
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
# INTERVALS_REDIRECT_URI=https://www.dzrracingseries.com/api/intervals/callback
# Signs connect links and encrypts tokens. Same value on Vercel and Render.
# If coach memory was encrypted before this change, paste the previous connect-secret value here.
COACH_CONNECT_SECRET=
# Optional dedicated token key. If unset, COACH_CONNECT_SECRET is used.
# If you previously set a dedicated token key, paste that value here or stored tokens will not decrypt.
# COACH_TOKEN_KEY=
# Optional dedicated encryption key for coach memory. If unset, COACH_CONNECT_SECRET is used.
# Must be the same on Vercel and Render if you set it.
# COACH_MEMORY_KEY=
